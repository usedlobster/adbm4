    "ext-xdebug": "*",
    "ext-zend-opcache": "*",
    "eftec/bladeone": ">=4.19.1",
    "ezyang/htmlpurifier": "^4.19",
    "hugerte/hugerte": "^1.0",
    "phpmailer/phpmailer": "^6.10",
    "vlucas/phpdotenv": "^5.6"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
